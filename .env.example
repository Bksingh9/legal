# Supabase (ap-south-1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
# All routes degrade to deterministic mocks when ANTHROPIC_API_KEY is unset.
ANTHROPIC_API_KEY=
ANTHROPIC_TRIAGE_MODEL=claude-sonnet-4-6
ANTHROPIC_CLASSIFY_MODEL=claude-haiku-4-5-20251001

# Sarvam.ai (Indic/Hindi STT). Falls back to Anthropic transcription if unset.
SARVAM_API_KEY=

# Razorpay (INR)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe (NRI)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Telephony
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_VIRTUAL_NUMBER=

# Video
HMS_ACCESS_KEY=
HMS_SECRET=
HMS_TEMPLATE_ID=

# WhatsApp (AiSensy or Gupshup)
WHATSAPP_PROVIDER=aisensy
AISENSY_API_KEY=
GUPSHUP_API_KEY=

# Email
RESEND_API_KEY=
RESEND_FROM=hello@legaldesk.ai

# Analytics + errors
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

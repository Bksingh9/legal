# Supabase (ap-south-1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# LLM provider routing
#
# Each workload picks a backend independently. Leave blank to use the
# router's fallback chain:
#
#   local -> anthropic -> openai -> openrouter -> sarvam -> ollama -> mock
#
# The `local` provider is always available (zero keys, deterministic
# Indian-law templates) and is first by design — so Tier-0 deploys work
# without any API keys. Set any of the LLM_* selectors below to pin a
# workload to a specific paid backend.
#
# Values: local | anthropic | openai | ollama | openrouter | sarvam | mock
# ---------------------------------------------------------------------------
LLM_CLASSIFY=
LLM_DRAFT=
LLM_SUMMARIZE=
LLM_BLOG=

# Anthropic
# When set, the abstraction's anthropic provider is available.
ANTHROPIC_API_KEY=
ANTHROPIC_TRIAGE_MODEL=claude-sonnet-4-6
ANTHROPIC_CLASSIFY_MODEL=claude-haiku-4-5-20251001

# OpenAI (and Azure OpenAI for India residency)
# Vanilla OpenAI: leave OPENAI_BASE_URL blank.
# Azure India: set OPENAI_BASE_URL to your resource's deployments URL.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_DRAFT_MODEL=gpt-4o
OPENAI_CLASSIFY_MODEL=gpt-4o-mini

# Ollama (self-hosted, zero API spend)
# Pull a model once:  ollama pull llama3.1:8b
# Then set OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_BASE_URL=
OLLAMA_DRAFT_MODEL=llama3.1:8b
OLLAMA_CLASSIFY_MODEL=llama3.1:8b

# OpenRouter (unified gateway across many vendors)
OPENROUTER_API_KEY=
OPENROUTER_DRAFT_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_CLASSIFY_MODEL=anthropic/claude-haiku-4.5

# Sarvam.ai (Indic STT + chat; India-hosted)
SARVAM_API_KEY=
SARVAM_CHAT_MODEL=sarvam-m

# PostHog analytics (no-op when unset; free 1M events/month on cloud)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Sentry observability (no-op when unset)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Cloudflare Turnstile (optional bot protection on public forms)
CF_TURNSTILE_SITE_KEY=
CF_TURNSTILE_SECRET=

# Rate-limit bypass for the prod-smoke test suite (random secret)
RATE_LIMIT_BYPASS_KEY=

# Vercel Cron — same value on every cron HTTP call
CRON_SECRET=

# Web Push (VAPID) — Tier-0 push notifications. These are NOT a paid
# third-party API; the VAPID keypair is self-generated locally with
# `npx web-push generate-vapid-keys --json`. Set NEXT_PUBLIC_VAPID_PUBLIC_KEY
# and VAPID_PRIVATE_KEY from that JSON, plus a mailto: subject.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@legaldesk.ai

# UPI (zero-key payment path for India)
# Set these to your merchant VPA and display name to enable the
# upi://pay deep-link + QR checkout. No API key needed; money lands
# directly in your bank account against the VPA. Admin reconciles
# UTRs against the bank statement via /admin/payments.
UPI_VPA=
UPI_MERCHANT_NAME=

# Razorpay (INR) — optional paid amplifier for hosted checkout +
# automated webhook verification. Tier-0 uses UPI deep links above.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe (NRI)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Telephony
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_VIRTUAL_NUMBER=

# Video
HMS_ACCESS_KEY=
HMS_SECRET=
HMS_TEMPLATE_ID=

# WhatsApp (AiSensy or Gupshup)
WHATSAPP_PROVIDER=aisensy
AISENSY_API_KEY=
GUPSHUP_API_KEY=

# Email
RESEND_API_KEY=
RESEND_FROM=hello@legaldesk.ai

# Analytics + errors
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
